# ───────── Core ─────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldpharma?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
PORT=4000

# Comma-separated list of allowed CORS origins. Use "*" ONLY in dev.
#   Production: your admin host, e.g. "https://admin.fieldpharma.com"
#   Android app does not send Origin headers, so this doesn't need to list it.
CORS_ORIGIN="http://localhost:3000"

# Public URL of the admin/marketing site. Used in Razorpay callback URLs so
# the user is bounced back to the right page after paying.
APP_URL="http://localhost:3000"

# ───────── Cron auth (shared secret) ─────────
# Any long random string. Required header "x-cron-key" for /api/billing/cron/*
# endpoints so public internet can't fire your billing crons.
CRON_KEY="change-me-to-another-long-random-string"

# ───────── Razorpay (payments) ─────────
# Leave blank in dev — the backend will return a stub payment-link URL.
# For prod, get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Shared secret used to verify webhook signatures. Set the SAME value in the
# Razorpay dashboard → Webhooks when registering POST /api/billing/webhook.
RAZORPAY_WEBHOOK_SECRET=""

# ───────── MSG91 WhatsApp OTP (primary channel) ─────────
# Leave blank in dev — the backend will print the OTP to the server console
# and surface it in the signup response (channel: "dev").
MSG91_WA_AUTH_KEY=""
# Your approved WhatsApp Business number (digits only, no +).
MSG91_WA_INTEGRATED_NUMBER=""
# An approved template name with exactly ONE body variable (the OTP).
# Register at https://control.msg91.com → WhatsApp → Templates.
#   Body example: "Your FieldPharma verification code is {{1}}. Do not share."
MSG91_WA_TEMPLATE_NAME=""
MSG91_WA_LANGUAGE_CODE="en"
MSG91_WA_NAMESPACE=""

# ───────── MSG91 SMS OTP (fallback channel) ─────────
# Used only when WhatsApp send fails or isn't configured.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""            # 6-char DLT-approved sender id, e.g. "FLDPHM"
MSG91_OTP_TEMPLATE_ID=""      # DLT template with ##OTP## variable
