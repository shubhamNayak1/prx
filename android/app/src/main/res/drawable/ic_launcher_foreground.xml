<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground. Shows the brand logo inside the 66dp safe-zone
  (18dp of padding on all sides) so OEM masks (circle, squircle, teardrop)
  never crop into the logo content.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_logo"
    android:inset="18dp" />
